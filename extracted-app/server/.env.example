# Port the server listens on (hosts like Render set this for you)
PORT=3001

# Websites allowed to use this server, comma-separated. "*" allows any (fine for development).
# A * inside an entry matches one subdomain part, e.g. Vercel preview links:
# CORS_ORIGIN=https://draw-guess.vercel.app,https://draw-guess-*.vercel.app
CORS_ORIGIN=*

# Optional: folder with the exported web app, to host the app on this server too
# WEB_DIR=../app/dist
